<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             Title="HospedagemContratada"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="AntiqueWhite">

    <VerticalStackLayout VerticalOptions="CenterAndExpand">

        <!-- Busca dinamicamente a propriedade Descricao de dentro de QuartoSelecionado -->
        <Label Text="{Binding QuartoSelecionado.Descricao}"
               TextColor="Teal"
               FontFamily="KalamRegular"
               FontSize="40"
               HorizontalTextAlignment="Center"/>

        <!-- Bloco de Hóspedes -->
        <Frame Margin="10" BackgroundColor="LightGrey">
            <Grid ColumnDefinitions="*, *">
                <HorizontalStackLayout Grid.Column="0" HorizontalOptions="Start">
                    <Label Text="Adultos : " 
                           FontAttributes="Bold"/>
                    <Label Text="{Binding QuantidadeAdultos}" 
                           TextColor="Teal" 
                           FontAttributes="Bold"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Grid.Column="1" HorizontalOptions="End">
                    <Label Text="Crianças : " FontAttributes="Bold"/>
                    <Label Text="{Binding QuantidadeCriancas}" 
                           TextColor="Teal" 
                           FontAttributes="Bold"/>
                </HorizontalStackLayout>
            </Grid>
        </Frame>

        <!-- Bloco de Datas e Estadia Dinâmicas -->
        <Frame Margin="10" BackgroundColor="LightGrey">
            <Grid ColumnDefinitions="*, *, *" RowDefinitions="Auto, Auto">
                <Label Grid.Row="0" Grid.Column="0" Text="Check-in: " />
                <Label Grid.Row="0" Grid.Column="1" Text="Check-out: " />
                <Label Grid.Row="0" Grid.Column="2" Text="Estadia: " />

                <!-- Formatação StringFormat para exibir apenas data sem o horário -->
                <Label Grid.Row="1" Grid.Column="0" Text="{Binding DataCheckIn, StringFormat='{0:dd/MM/yyyy}'}" />
                <Label Grid.Row="1" Grid.Column="1" Text="{Binding DataCheckOut, StringFormat='{0:dd/MM/yyyy}'}" />

                <!-- Exibe os dias calculados automaticamente -->
                <HorizontalStackLayout Grid.Row="1" Grid.Column="2">
                    <Label Text="{Binding QuantidadeDias}" />
                    <Label Text=" dia(s)" />
                </HorizontalStackLayout>
            </Grid>
        </Frame>

        <!-- Bloco de Valor Total -->
        <Frame Margin="10" BackgroundColor="LightGrey">
            <HorizontalStackLayout HorizontalOptions="Center">
                <Label Text="Valor Total: " FontAttributes="Bold"/>
                <!-- Exibe o resultado final da conta formatado em Moeda (R$) -->
                <Label Text="{Binding ValorTotal, StringFormat='R$ {0:F2}'}" 
                       TextColor="Teal" 
                       FontAttributes="Bold"/>
            </HorizontalStackLayout>
        </Frame>

        <!-- Botão Voltar -->
        <Button Text="Voltar"
                TextColor="Green"
                HorizontalOptions="Center"
                BackgroundColor="LightGrey"
                Clicked="Button_Clicked"/>

    </VerticalStackLayout>
</ContentPage>